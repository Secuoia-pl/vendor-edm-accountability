# Opcjonalne — bez tego bot działa na szablonach

# OpenAI-compatible API (OpenAI / OpenRouter / lokalny proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- analyze.py (hub / LI / X) ---
ATLASCLOUD_API_KEY=
ANALYZE_PROVIDER=atlas
ANALYZE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Wiro
WIRO_API_KEY=
WIRO_ANALYZE_MODEL=ByteDance/seed-v2.1-turbo

# --- WordPress (bezpiecznyblog.pl) ---
WP_BASE_URL=https://bezpiecznyblog.pl
WP_USER=
WP_APP_PASSWORD=
WP_INDEX_SLUG=hub-odpowiedzialnosci
WP_HUB_SLUG=odpowiedzialnosc-vendora-edm
WP_CHECKLIST_SLUG=checklista-72h-vendor-edm

# --- Powiadomienia (ntfy + Signal; bez Telegrama) ---
# 1) ntfy: ustaw losowy topic, w apce zasubskrybuj ten sam topic
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# NTFY_TOKEN=

# 2a) Signal przez Docker REST (zalecane na Windows)
# SIGNAL_REST_URL=http://127.0.0.1:8080
# SIGNAL_NUMBER=+48xxxxxxxxx
# SIGNAL_RECIPIENTS=+48xxxxxxxxx

# 2b) Signal przez lokalny signal-cli
# SIGNAL_CLI_PATH=signal-cli
# SIGNAL_CLI_ACCOUNT=+48xxxxxxxxx
# SIGNAL_RECIPIENTS=+48xxxxxxxxx
