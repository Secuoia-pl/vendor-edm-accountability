# Opcjonalne — bez tego bot działa na szablonach

# OpenAI-compatible API (OpenAI / OpenRouter / lokalny proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- analyze.py (hub / LI / X) ---
# Atlas Cloud — chat OpenAI-compatible (Grok, DeepSeek, Qwen…)
ATLASCLOUD_API_KEY=
ANALYZE_PROVIDER=atlas
ANALYZE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# ANALYZE_MODEL=xai/grok-4.6

# Wiro — modele tekstowe (Seed, Grok, Qwen…) jako fallback / provider=wiro
WIRO_API_KEY=
WIRO_ANALYZE_MODEL=ByteDance/seed-v2.1-turbo
# WIRO_BASE_URL=https://api.wiro.ai/v1

# --- WordPress (bezpiecznyblog.pl) — REST + Application Password ---
WP_BASE_URL=https://bezpiecznyblog.pl
WP_USER=
# Haslo aplikacji z WP: Uzytkownicy -> Profil -> Application Passwords (bez spacji lub ze spacjami)
WP_APP_PASSWORD=
# Opcjonalnie ID stron (albo wykrywane po slug):
# WP_HUB_PAGE_ID=
# WP_CHECKLIST_PAGE_ID=
WP_HUB_SLUG=odpowiedzialnosc-vendora-edm
WP_CHECKLIST_SLUG=checklista-72h-vendor-edm

# Telegram — powiadomienie o nowym drafcie do akceptacji
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
